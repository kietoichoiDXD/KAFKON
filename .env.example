# ==============================================================================
# ScribeBA — Environment Configuration & Credentials Template
# AI Tinkerers Hackathon (Da Nang 2026) · Team KAFKON
# ==============================================================================

# 1. Chế độ thực thi hệ thống
# - 'local': Chạy mô phỏng ngoại tuyến (Offline Demo - 100% không sợ rớt mạng)
# - 'live' : Chạy kết nối API trực tiếp (Slack Socket Mode, Telegram Poller, ClickUp)
# Set this to 'live' to use Nebius as an analysis provider; local mode stays deterministic/offline.
SCRIBEBA_MODE=local

# 2. Cấp độ Fallback suy luận (Multi-Tier Model Cascade)
# - 'low'   : Tối thiểu chi phí ($0.0005) - Lọc nhanh (gpt-4o-mini, llama-3.2-3b)
# - 'medium': Cân bằng Agile chuẩn ($0.0150) - (gpt-4o, claude-3.7-sonnet, o3-mini)
# - 'high'  : Suy luận hợp đồng sâu ($0.0350) - (claude-3.7-thinking, deepseek-r1)
FALLBACK_TIER=medium

# Chat history and tasks database:
# - Leave blank to use local SQLite: <project>/.scribeba/chat-history.sqlite3
# - Or set DATABASE_URL (or SUPABASE_DATABASE_URL) to connect to Supabase PostgreSQL:
#   DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=
SUPABASE_DATABASE_URL=
# SCRIBEBA_CHAT_HISTORY_DB_PATH=/data/scribeba/chat-history.sqlite3

# 3. Skill mặc định kích hoạt (startup_lean, agency_detailed, default)
DEFAULT_SKILL=startup_lean

# ------------------------------------------------------------------------------
# 4. Nhà Tài Trợ AI (Sponsor Credentials)
# ------------------------------------------------------------------------------
# OpenRouter API (Cổng định tuyến LLM & chống rớt mạng)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-sonnet-5
OPENROUTER_TRIAGE_MODEL=anthropic/claude-haiku-4.5

# Nebius AI Studio (OpenAI-compatible; used as a fallback after configured primary providers)
NEBIUS_API_KEY=your_nebius_api_key
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1/
NEBIUS_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507

# Exa Neural Search (Tra cứu tri thức kỹ thuật & chuẩn bảo mật RFC bên ngoài)
EXA_API_KEY=your_exa_api_key_here

# OpenAI Codex (Sinh kịch bản Gherkin & code Playwright test tự động)
OPENAI_API_KEY=your_openai_api_key_here
CODEX_MODEL=gpt-4o

# Anthropic Direct API (Kênh dự phòng trực tiếp nếu OpenRouter hết token)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_ROUTING_MODEL=claude-haiku-4-5
ANTHROPIC_REASONING_MODEL=claude-opus-5

# ------------------------------------------------------------------------------
# 5. Nền Tảng Trò Chuyện Nhóm (Workplace Communication)
# ------------------------------------------------------------------------------
# Telegram Bot (Lấy từ @BotFather trên Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Slack Bolt (Socket Mode)
SLACK_BOT_TOKEN=your_slack_bot_token
SLACK_USER_TOKEN=
SLACK_APP_TOKEN=xapp-your-slack-app-token
SLACK_SIGNING_SECRET=your-slack-signing-secret

# Slack multi-workspace OAuth (configure these in the backend environment only).
# Add the exact SLACK_REDIRECT_URI to the Slack app's OAuth Redirect URLs.
SLACK_CLIENT_ID=your_slack_app_client_id
SLACK_CLIENT_SECRET=your_slack_app_client_secret
SLACK_REDIRECT_URI=http://localhost:3000/api/slack/oauth/callback
# If testing through an ngrok HTTPS hostname, set this to the exact registered URL,
# e.g. https://your-host.ngrok-free.app/slack/oauth_redirect, and open the UI via that hostname.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SLACK_INSTALLATION_ENCRYPTION_KEY=replace_with_generated_fernet_key
# Persistent writable location; mount durable storage here in production.
SLACK_INSTALLATION_DB_PATH=.scribeba/slack-installations.sqlite3

# Discord Bot (Tùy chọn)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# ------------------------------------------------------------------------------
# 6. Phần Mềm Quản Lý Dự Án (Task Management Destination)
# ------------------------------------------------------------------------------
# ClickUp API
CLICKUP_API_KEY=pk_your_clickup_api_token
CLICKUP_TEAM_ID=your_team_id
CLICKUP_SPACE_ID=your_space_id
CLICKUP_LIST_ID=your_list_id

# Discord incident notifications (Server Settings > Integrations > Webhooks)
DISCORD_WEBHOOK_URL=

# Public sign-in through Amazon Cognito (Google federation is optional)
SCRIBEBA_PUBLIC_MODE=false
SCRIBEBA_APP_PASSWORD=replace-locally
SCRIBEBA_SESSION_SECRET=replace-with-at-least-32-random-characters
SCRIBEBA_ALLOWED_ORIGIN=https://your-app.example.com
COGNITO_REGION=ap-southeast-1
COGNITO_USER_POOL_ID=replace-with-user-pool-id
COGNITO_CLIENT_ID=replace-with-public-app-client-id
COGNITO_DOMAIN=replace-with-cognito-domain
COGNITO_GOOGLE_ENABLED=false
SCRIBEBA_ADMIN_EMAILS=admin@example.com
