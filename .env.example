# ScribeBA Environment Configuration

# Execution Mode: 'local' (mocked/offline demo) or 'live' (real API/MCP calls)
SCRIBEBA_MODE=local

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_ROUTING_MODEL=claude-3-5-haiku-20241022
ANTHROPIC_REASONING_MODEL=claude-3-7-sonnet-20250219

# ClickUp Configuration
CLICKUP_API_KEY=pk_your_clickup_api_token
CLICKUP_TEAM_ID=your_team_id
CLICKUP_SPACE_ID=your_space_id
CLICKUP_LIST_ID=your_list_id

# Slack Integration (Socket Mode or Webhook)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_SIGNING_SECRET=your_signing_secret

# Discord Integration (Optional)
DISCORD_BOT_TOKEN=your_discord_bot_token

# Active Skill Profile (default, startup_lean, agency_detailed)
DEFAULT_SKILL=startup_lean

# Sponsor Integrations (AI Tinkerers Hackathon 2026)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-3.7-sonnet
OPENROUTER_TRIAGE_MODEL=anthropic/claude-3.5-haiku

EXA_API_KEY=your_exa_api_key_here
OPENAI_API_KEY=your_openai_codex_key_here
CODEX_MODEL=gpt-4o
