# ==============================================================================
# ScribeBA — Environment Configuration & Credentials Template
# AI Tinkerers Hackathon (Da Nang 2026) · Team KAFKON
# ==============================================================================

# 1. Chế độ thực thi hệ thống
# - 'local': Chạy mô phỏng ngoại tuyến (Offline Demo - 100% không sợ rớt mạng)
# - 'live' : Chạy kết nối API trực tiếp (Slack Socket Mode, Telegram Poller, ClickUp)
SCRIBEBA_MODE=local

# 2. Cấp độ Fallback suy luận (Multi-Tier Model Cascade)
# - 'low'   : Tối thiểu chi phí ($0.0005) - Lọc nhanh (gpt-4o-mini, llama-3.2-3b)
# - 'medium': Cân bằng Agile chuẩn ($0.0150) - (gpt-4o, claude-3.7-sonnet, o3-mini)
# - 'high'  : Suy luận hợp đồng sâu ($0.0350) - (claude-3.7-thinking, deepseek-r1)
FALLBACK_TIER=medium

# 3. Skill mặc định kích hoạt (startup_lean, agency_detailed, default)
DEFAULT_SKILL=startup_lean

# ------------------------------------------------------------------------------
# 4. Nhà Tài Trợ AI (Sponsor Credentials)
# ------------------------------------------------------------------------------
# OpenRouter API (Cổng định tuyến LLM & chống rớt mạng)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-sonnet-5
OPENROUTER_TRIAGE_MODEL=anthropic/claude-haiku-4.5

# Exa Neural Search (Tra cứu tri thức kỹ thuật & chuẩn bảo mật RFC bên ngoài)
EXA_API_KEY=your_exa_api_key_here

# OpenAI Codex (Sinh kịch bản Gherkin & code Playwright test tự động)
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
CODEX_MODEL=gpt-4o

# Anthropic Direct API (Kênh dự phòng trực tiếp nếu OpenRouter hết token)
ANTHROPIC_API_KEY=sk-ant-api03-your_anthropic_api_key_here
ANTHROPIC_ROUTING_MODEL=claude-haiku-4-5
ANTHROPIC_REASONING_MODEL=claude-opus-5

# ------------------------------------------------------------------------------
# 5. Nền Tảng Trò Chuyện Nhóm (Workplace Communication)
# ------------------------------------------------------------------------------
# Telegram Bot (Lấy từ @BotFather trên Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Slack Bolt (Socket Mode)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_USER_TOKEN=
SLACK_APP_TOKEN=xapp-your-slack-app-token
SLACK_SIGNING_SECRET=your-slack-signing-secret

# Discord Bot (Tùy chọn)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# ------------------------------------------------------------------------------
# 6. Phần Mềm Quản Lý Dự Án (Task Management Destination)
# ------------------------------------------------------------------------------
# ClickUp API
CLICKUP_API_KEY=pk_your_clickup_api_token
CLICKUP_TEAM_ID=your_team_id
CLICKUP_SPACE_ID=your_space_id
CLICKUP_LIST_ID=your_list_id

# Discord incident notifications (Server Settings > Integrations > Webhooks)
DISCORD_WEBHOOK_URL=
